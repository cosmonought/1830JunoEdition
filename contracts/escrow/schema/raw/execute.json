        "log_len",
        "overdue_at",
        "overdue_epoch",
        "remedy",
        "remedy_key_id",
        "strike",
        "version"
      ],
      "properties": {
        "allowance_secs": {
          "$ref": "#/definitions/Uint64"
        },
        "attested_at": {
          "description": "When the REMEDY key signed: `final_at ≤ attested_at ≤` block time.",
          "allOf": [
            {
              "$ref": "#/definitions/Uint64"
            }
          ]
        },
        "chain_game_id": {
          "$ref": "#/definitions/Uint64"
        },
        "defaulting_seat": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "domain": {
          "description": "32 bytes: the game's settlement domain.",
          "allOf": [
            {
              "$ref": "#/definitions/HexBinary"
            }
          ]
        },
        "evidence_hash": {
          "description": "32 bytes.",
          "allOf": [
            {
              "$ref": "#/definitions/HexBinary"
            }
          ]
        },
        "expires_at": {
          "$ref": "#/definitions/Uint64"
        },
        "final_at": {
          "$ref": "#/definitions/Uint64"
        },
        "log_hash": {
          "description": "32 bytes.",
          "allOf": [
            {
              "$ref": "#/definitions/HexBinary"
            }
          ]
        },
        "log_len": {
          "$ref": "#/definitions/Uint64"
        },
        "overdue_at": {
          "$ref": "#/definitions/Uint64"
        },
        "overdue_epoch": {
          "$ref": "#/definitions/Uint64"
        },
        "remedy": {
          "description": "1 LiveTimeoutAnnul, 2 LiveForeclose, 3 LiveStrike3Foreclose, 4 AsyncAnnul, 5 AsyncForeclose.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "remedy_key_id": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "strike": {
          "description": "Live: 1, 2 (remedies 1–2) or 3 (remedy 3). Async: 0.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "version": {
          "description": "Exactly 1.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "ResolveOutcome": {
      "oneOf": [
        {
          "description": "The stored settlement stands; the challenger's bond joins the pool.",
          "type": "object",
          "required": [
            "uphold"
          ],
          "properties": {
            "uphold": {
              "type": "object",
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "description": "A corrected payload (reason ResolverCorrection) authorised by the resolver's transaction; the bond goes back to the challenger. Its seq must exceed the game's trusted checkpoint floor only: the disputed settlement never constrains it, so the same log position is legal. Refused for an escrow 2.1.0 third-strike foreclosure (`RemedySettlementNotReplaceable`): that one is upheld or annulled.",
          "type": "object",
          "required": [
            "replace"
          ],
          "properties": {
            "replace": {
              "type": "object",
              "required": [
                "payload"
              ],
              "properties": {
                "payload": {
                  "$ref": "#/definitions/SettlementPayloadV1"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Refund every seat's net ante; the bond goes back to the challenger.",
          "type": "object",
          "required": [
            "annul"
          ],
          "properties": {
            "annul": {
              "type": "object",
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "SeatSignature": {
      "description": "A seat's consent (or annul) signature: 64-byte low-s `r ‖ s`.",
      "type": "object",
      "required": [
        "seat_index",
        "signature"
      ],
      "properties": {
        "seat_index": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
