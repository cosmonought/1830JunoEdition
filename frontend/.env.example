# 18Cosmos frontend -- deployment configuration (F-4)
#
# Copy to `.env` and fill in.
#
# NOTHING HERE IS REQUIRED AT STARTUP. Both config modules read deferred and
# never throw at import (`src/config.ts` design note #0, `src/config/
# firebase.ts` design note #1) -- an unset value degrades one subsystem and
# says so in the UI, rather than taking down the whole bundle:
#
#   REACT_APP_CONTRACT_ADDRESS / _FEE_GRANTER / _CHAIN_ID / _RPC_ENDPOINT
#     unset -> Offline Sandbox Mode. The tile catalog is browsable; wallet
#     connection and every transaction are unavailable.
#
#   REACT_APP_FIREBASE_*
#     unset -> no lobby, no chat, no presence. The board and every on-chain
#     query still work.
#
# react-scripts substitutes REACT_APP_* at BUILD time. Changing anything here
# requires a rebuild, not just a dev-server restart.
#
# Nothing here is secret -- it all ships to the browser. Never put a private
# key or an API secret in this file.

# The deployed 18Cosmos contract. Must be the SAME address the session key's
# authz grant is scoped to (config.ts handles that -- it is one constant now).
REACT_APP_CONTRACT_ADDRESS=juno1yourcontractaddresshere000000000000000000

# The developer treasury that pays gas for session-key transactions.
# MUST equal the contract's own `GameConfig::developer_treasury`. If these two
# differ, the treasury accrues fees from lobby deposits while every player's
# session-key transaction fails for want of a fee grant.
REACT_APP_FEE_GRANTER=juno1yourfeegranteraddresshere0000000000000000

# Chain id passed to keplr.enable / getOfflineSigner.
#   mainnet: juno-1     testnet: uni-7
REACT_APP_CHAIN_ID=juno-1

# RPC endpoint for both signing clients.
REACT_APP_RPC_ENDPOINT=https://rpc-juno.itastakers.com


# ===================================================================
#  Firebase -- OFF-CHAIN ONLY (Step 4: Real-Time Integration)
# ===================================================================
#
# Carries exactly three things: chat, player presence, and pre-game room
# discovery. The Juno contract above remains the single source of truth for
# all game state -- see `src/config/firebase.ts` design note #0.
#
# Copy these from the Firebase console:
#   Project settings -> General -> Your apps -> SDK setup and configuration
#
# A Firebase "API key" is NOT a credential. It is a public project
# identifier that ships to every browser and grants nothing on its own --
# what actually protects the data is `firestore.rules` in the repo root.
# DEPLOY THOSE RULES before Test Mode expires (~30 days from database
# creation), or the database flips from world-writable to denying
# everything:
#
#   firebase deploy --only firestore:rules

# Required for Firestore.
REACT_APP_FIREBASE_API_KEY=AIzaSyYourBrowserApiKeyGoesHere0000000000
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_APP_ID=1:123456789012:web:abc123def456abc123def4

# Optional -- accepted and passed through when set, but nothing in this app
# reads them today. `authDomain` is Firebase Auth (not yet used; see the
# authentication gap documented in firestore.rules), `storageBucket` is
# Cloud Storage, `messagingSenderId` is FCM. Left unset, the SDK falls back
# to its own defaults.
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789012
