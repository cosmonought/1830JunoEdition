# frontend/.env.production -- read by `npm run build` (react-app-rewired build) ONLY; `npm start` never reads it.
#
# LIVE-2E: A PRODUCTION BUILD CARRIES NO SOURCE MAPS. A source map is the original source, comments and all, and the
# LIVE-2D artifact gate found the development-identity branch's text in `static/js/main.*.js.map` even though the
# minifier had deleted the branch from the code itself. Setting this here makes every production build map-free
# without anybody remembering an environment variable; `npm run build` then runs `scripts/scanDevIdentity.js`
# (as part of the build script itself), which fails the build if a development claim OR any `.map` file is in it.
#
# Debugging a production bundle locally with maps is still possible (GENERATE_SOURCEMAP=true on the command line
# beats this file), but that bundle fails the scan on purpose and must never be deployed.
GENERATE_SOURCEMAP=false
