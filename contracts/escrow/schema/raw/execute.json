        }
      },
      "additionalProperties": false
    },
    "SettlementPayloadV1": {
      "description": "SettlementPayloadV1, amended layout (SET-0A rev 2 §21), in field order. The contract re-encodes it to the canonical `136 + 16·n` bytes before hashing; nothing here is hashed as JSON.",
      "type": "object",
      "required": [
        "appraisal_log_len",
        "appraisal_state_hash",
        "domain",
        "issued_at",
        "kind",
        "log_hash",
        "log_len",
        "reason",
        "seat_count",
        "seq",
        "settlement_weights",
        "signer_key_id",
        "state_schema_version",
        "version"
      ],
      "properties": {
        "appraisal_log_len": {
          "$ref": "#/definitions/Uint64"
        },
        "appraisal_state_hash": {
          "description": "32 bytes.",
          "allOf": [
            {
              "$ref": "#/definitions/HexBinary"
            }
          ]
        },
        "domain": {
          "description": "32 bytes: this game's settlement domain.",
          "allOf": [
            {
              "$ref": "#/definitions/HexBinary"
            }
          ]
        },
        "issued_at": {
          "$ref": "#/definitions/Uint64"
        },
        "kind": {
          "description": "0 = Checkpoint, 1 = Terminal.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "log_hash": {
          "description": "32 bytes.",
          "allOf": [
            {
              "$ref": "#/definitions/HexBinary"
            }
          ]
        },
        "log_len": {
          "$ref": "#/definitions/Uint64"
        },
        "reason": {
          "description": "0 RoundBoundary, 1 BankBroken, 2 Bankruptcy, 3 Forfeit, 4 Clemency, 5 ResolverCorrection; anything else is refused.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "seat_count": {
          "description": "Must equal `settlement_weights.len()` and the roster length.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "seq": {
          "description": "`2·log_len + kind_bit`.",
          "allOf": [
            {
              "$ref": "#/definitions/Uint64"
            }
          ]
        },
        "settlement_weights": {
          "description": "Unsigned u128 weights in `chain_seat_index` order; Σ > 0.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Uint128"
          }
