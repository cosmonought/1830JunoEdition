# Copy to <env>.tfvars (not committed) and apply with the APP account's credentials:
#   terraform init -backend-config="bucket=<state bucket>" -backend-config="key=gs/<env>/app.tfstate" -backend-config="region=<region>"
#   terraform plan -var-file=<env>.tfvars -out=app.tfplan
region         = "us-east-1"
app_account_id = "111111111111"
environment    = "staging"
generation     = 1

ledger_table_arn = "arn:aws:dynamodb:us-east-1:222222222222:table/gs-staging-ledger" # ledger stack output

# null until the ledger stack has created the keys; then its signing_key_arns output:
signing_keys = {
  relayer    = "arn:aws:kms:us-east-1:222222222222:key/11111111-1111-4111-8111-111111111111"
  settlement = "arn:aws:kms:us-east-1:222222222222:key/22222222-2222-4222-8222-222222222222"
  admission  = "arn:aws:kms:us-east-1:222222222222:key/33333333-3333-4333-8333-333333333333"
}

# LIVE-6 relayer rotation (infra/aws/README.md "Relayer rotation"): [] normally. PREPARE: the ledger stack's new
# relayer_key_arns.r<N> here (the verifier reads it; nothing signs with it). SWITCH (inside the drained window, after the
# gate and SetOperator): signing_keys.relayer = that key, and the previous relayer key here (kept readable for rollback).
# relayer_rotation_key_arns = ["arn:aws:kms:us-east-1:222222222222:key/66666666-6666-4666-8666-666666666666"]

# null: no escrow. Public keys and the relayer address: `npm run awsDeploy -- signer-keys --relayer <arn> ...`.
escrow = null

network = {
  vpc_id                  = "vpc-0123456789abcdef0"
  task_subnet_ids         = ["subnet-0aaaaaaaaaaaaaaa1", "subnet-0aaaaaaaaaaaaaaa2"]
  alb_subnet_ids          = ["subnet-0bbbbbbbbbbbbbbb1", "subnet-0bbbbbbbbbbbbbbb2"]
  private_route_table_ids = ["rtb-0ccccccccccccccc1"]
}

build_id        = "2026-09-30-da317f0"
allowed_origins = ["https://play.example.com"]

# PHASE 1 CLEAN-BUILD RESET: REQUIRED (no default). The final state is "none": the single host (stacks/single-host) serves
# and this stack keeps only the authorities and the edge (infra/aws/PHASE1_CLEAN_BUILD.md). "ecs" recreates the retired
# ECS / ALB / endpoint topology and its cost. Under "none" the alb block and the task / ALB subnets below are inert.
compute = "none"

# LIVE-6 L6-2: every pool gets its own target group and exact /gs/p/<pool> rule; `primary` follows SYSTEM/ROUTING
# (move it only after `gamesDoctor aws flip ... --apply`). desired_count 0: a drained / retired pool (never the primary).
# The final state is ONE pool, p1.
pools          = { p1 = { primary = true } }
start_services = false # a NEW environment's first apply only; true after the bootstrap and verify (and always once a host serves)

alb = {
  certificate_arn = "arn:aws:acm:us-east-1:111111111111:certificate/44444444-4444-4444-8444-444444444444"
}

edge = {
  create_distribution     = true
  aliases                 = ["play.example.com"]
  viewer_certificate_arn  = "arn:aws:acm:us-east-1:111111111111:certificate/55555555-5555-4555-8555-555555555555"
  site_origin_domain_name = "site-origin.example.com"
  alb_origin_domain_name  = "gs-origin.example.com"
}

bootstrap_trusted_principal_arns = ["arn:aws:iam::111111111111:role/deploy-pipeline"]

# LIVE-6 L6-2: the operator (`gamesDoctor aws`) and recovery (`npm run recovery`) roles; empty lists create neither.
operator_trusted_principal_arns = []
recovery_trusted_principal_arns = []

# LIVE-6 L6-5B: where PAGE and TICKET alarms notify (SNS topics, Lambda functions, Incident Manager response plans, created
# elsewhere). Empty is valid in staging: the alarms still evaluate and `awsDeploy verify` checks their wiring class.
page_alarm_action_arns   = []
ticket_alarm_action_arns = []
