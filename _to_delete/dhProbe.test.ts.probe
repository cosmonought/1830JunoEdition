/** @jest-environment node */
// THROWAWAY PROBE -- Stage 9.4b timing audit. Not part of the deliverable.
export {};

import type { GameStateResponse } from "../gameEngine/gameState";
import type { MapGridResponse } from "../components/hexContractTypes";
import { STATIC_BOARD_HEXES, activateBoard, STANDARD_BOARD } from "../components/hexBoardData";
import { dhStationRefusal } from "../gameEngine/dhStationAuthority";
import { applySandboxLayTile } from "../gameEngine/sandboxSession";
import { board, P1, P2, DH } from "./offerFixtures74";
import { applyAsRoom, apply, corp, ingress, same, withCorp, M } from "./offerMatrix74Support";

afterAll(() => activateBoard(STANDARD_BOARD));

function hexAt(label: string) {
  const hex = STATIC_BOARD_HEXES.find((entry) => entry.label === label);
  if (!hex) throw new Error(`no ${label}`);
  return hex;
}
const at = (label: string): [number, number] => [hexAt(label).q, hexAt(label).r];

const OWNER = 31;
const RIVAL = 32;
const GRID = { game_id: 1, tiles: [] } as unknown as MapGridResponse;
const dhGrid = (): MapGridResponse => applySandboxLayTile(GRID, ...at("F16"), 57, 0, () => false);

function trackBoard(): GameStateResponse {
  const state = board({
    round: "OperatingRound",
    corps: [
      { id: OWNER, ticker: "OWN", president: P1, trains: ["2"], treasury: "500" },
      { id: RIVAL, ticker: "RIV", president: P2, trains: ["2"], treasury: "500" },
    ],
    privates: [{ id: DH, owner: null, ownerCorp: OWNER, cost: "70" }],
    operating: OWNER,
    step: "Track",
  });
  let out = withCorp(state, OWNER, { home_hex_label: "I15", station_token_hexes: [at("I15")], station_tokens: [] });
  out = withCorp(out, RIVAL, { home_hex_label: "H12", station_token_hexes: [at("H12")], station_tokens: [] });
  return out;
}

const dhLayMsg = () => ({
  LayTile: { game_id: 1, protocol_id: OWNER, q: hexAt("F16").q, r: hexAt("F16").r, tile_id: 57, orientation: 0, ability_key: "dh-tile" },
});
const dhStationMsg = (label = "F16", cityIndex: number | null = 0) => ({
  PlaceHomeStation: { game_id: 1, company_id: OWNER, q: hexAt(label).q, r: hexAt(label).r, kind: "dh" as const, city_index: cityIndex, hex_label: label },
});

it("PROBE: does the real lay open dh_station_pending and end Track?", () => {
  const before = trackBoard();
  expect(before.operating_sub_phase).toBe("Track");
  expect(before.dh_station_pending).toBeUndefined();

  const afterLay = apply(before, dhLayMsg(), P1, GRID);
  console.log("after lay: operating_sub_phase=", afterLay.operating_sub_phase, " dh_station_pending=", afterLay.dh_station_pending, " used_private_abilities=", afterLay.used_private_abilities);
  expect(afterLay.dh_station_pending).toBe(OWNER);
  expect(afterLay.operating_sub_phase).toBe("Tokens");
});

it("PROBE: crafted delayed placement after advancing past Tokens", () => {
  const before = trackBoard();
  const afterLay = apply(before, dhLayMsg(), P1, GRID);
  expect(afterLay.dh_station_pending).toBe(OWNER);
  expect(afterLay.operating_sub_phase).toBe("Tokens");

  const afterAdvance = apply(afterLay, M.advance(OWNER), P1, dhGrid());
  console.log("after advance: operating_sub_phase=", afterAdvance.operating_sub_phase, " dh_station_pending=", afterAdvance.dh_station_pending);
  expect(afterAdvance.operating_sub_phase).toBe("Routes");
  expect(afterAdvance.dh_station_pending).toBe(OWNER);

  const grid = dhGrid();
  const msg = dhStationMsg();
  const reason = dhStationRefusal(afterAdvance, msg.PlaceHomeStation, grid);
  console.log("dhStationRefusal reason (null = LEGAL):", reason);
  const ingressReason = ingress(afterAdvance, P1, msg, grid);
  console.log("ingress reason (null = LEGAL):", ingressReason);

  const placed = applyAsRoom(afterAdvance, msg, P1, grid);
  console.log("placed station_token_hexes:", corp(placed, OWNER).station_token_hexes);
  console.log("placed dh_station_pending:", placed.dh_station_pending);
  console.log("board changed (not same):", !same(placed, afterAdvance));
});

it("PROBE: even further -- through Routes/Dividends/Hardware, still same turn", () => {
  const before = trackBoard();
  const afterLay = apply(before, dhLayMsg(), P1, GRID);
  let s = apply(afterLay, M.advance(OWNER), P1, dhGrid());
  console.log("step1", s.operating_sub_phase, s.dh_station_pending);
  s = apply(s, M.advance(OWNER), P1, dhGrid());
  console.log("step2", s.operating_sub_phase, s.dh_station_pending);
  s = apply(s, M.advance(OWNER), P1, dhGrid());
  console.log("step3", s.operating_sub_phase, s.dh_station_pending);

  const grid = dhGrid();
  const msg = dhStationMsg();
  const reason = dhStationRefusal(s, msg.PlaceHomeStation, grid);
  console.log("at Hardware step, dhStationRefusal reason (null = LEGAL):", reason);
});
