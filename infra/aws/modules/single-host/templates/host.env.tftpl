# COST-1: this host's identity and wiring (rendered by Terraform, infra/aws/modules/single-host). NO secret, NO credential:
# the instance role (IMDSv2) is the only credential source. Read by the systemd units and /opt/gs/bin/*.
GS_ENVIRONMENT=${environment}
GS_REGION=${region}
GS_ARCH=${arch}
GS_ECR_REGISTRY=${ecr_registry}
GS_ECR_REPOSITORY=${ecr_repository}
GS_LOG_GROUP=${log_group}
GS_EXPECTED_PUBLIC_IP=${expected_public_ip}
GS_ORIGIN_HOSTNAME=${origin_hostname}
GS_CADDY_IMAGE=${caddy_image}
GS_CADDY_UID=${caddy_uid}
GS_SERVER_MEMORY=${server_memory}
GS_CONTAINER_PORT=${container_port}
GS_HOST_METRIC_NAMESPACE=${host_metric_namespace}
