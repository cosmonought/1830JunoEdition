# frontend/.env.development -- read by `npm start` (the CRA dev server) ONLY; `npm run build` never reads it.
#
# LIVE-2B (LIVE-2 §4.8): development identity. The dev server's bundle puts this tab's development principal claim (not a seat) on its game-server
# socket URL, which a GS_MODE=development game server accepts from this machine only (loopback Origin, Host and
# peer; no forwarding header). A production build is compiled without it and carries no dev claim at all
# (frontend/scripts/scanDevIdentity.js checks a build). Never deploy a bundle built with this set.
REACT_APP_DEV_IDENTITY=1
