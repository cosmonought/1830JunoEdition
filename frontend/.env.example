# 18Cosmos frontend -- deployment configuration (F-4)
#
# Copy to `.env` and fill in.
#
# NOTHING HERE IS REQUIRED AT STARTUP. Both config modules read deferred and
# never throw at import (`src/config.ts` design note #0, `src/config/
# backend.ts` design note #1361) -- an unset value degrades one subsystem and
# says so in the UI, rather than taking down the whole bundle:
#
#   REACT_APP_CONTRACT_ADDRESS / _FEE_GRANTER / _CHAIN_ID / _RPC_ENDPOINT
#     unset -> Offline Sandbox Mode. The tile catalog is browsable; wallet
#     connection and every transaction are unavailable.
#
#   REACT_APP_GAME_SERVER_URL
#     unset -> no lobby, no chat, no presence. The board and every on-chain
#     query still work.
#
# react-scripts substitutes REACT_APP_* at BUILD time. Changing anything here
# requires a rebuild, not just a dev-server restart.
#
# Nothing here is secret -- it all ships to the browser. Never put a private
# key or an API secret in this file.

# The deployed 18Cosmos contract. Must be the SAME address the session key's
# authz grant is scoped to (config.ts handles that -- it is one constant now).
REACT_APP_CONTRACT_ADDRESS=juno1yourcontractaddresshere000000000000000000

# The developer treasury that pays gas for session-key transactions.
# MUST equal the contract's own `GameConfig::developer_treasury`. If these two
# differ, the treasury accrues fees from lobby deposits while every player's
# session-key transaction fails for want of a fee grant.
REACT_APP_FEE_GRANTER=juno1yourfeegranteraddresshere0000000000000000

# Chain id passed to keplr.enable / getOfflineSigner.
#   mainnet: juno-1     testnet: uni-7
REACT_APP_CHAIN_ID=juno-1

# RPC endpoint for both signing clients.
REACT_APP_RPC_ENDPOINT=https://rpc-juno.itastakers.com


# ===================================================================
#  Real-time backend -- the game server (design note #1361)
# ===================================================================
#
# Chat, presence, the waiting-room roster, the staging lobby and the action log all ride ONE WebSocket to the
# Node game server (`server/`). There is no Firebase: it was removed in #1361 when its test-mode window closed.
# Leave this unset and the rail map, tile catalog and every on-chain query still work; every real-time surface
# labels itself offline. Set in `.env.local` for a local or tunnelled playtest (see PLAYTEST_TRANSPORT.md).
#
#   REACT_APP_GAME_SERVER_URL=ws://127.0.0.1:8917
#   REACT_APP_BUILD_ID=dev
