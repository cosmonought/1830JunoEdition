# 18Cosmos frontend -- deployment configuration (F-4)
#
# Copy to `.env` and fill in. Every value is REQUIRED: `src/config.ts` throws
# at import if any is unset or still a placeholder, so the app fails at
# startup with a clear message rather than at transaction-broadcast time with
# an opaque one.
#
# react-scripts substitutes REACT_APP_* at BUILD time. Changing anything here
# requires a rebuild, not just a dev-server restart.
#
# Nothing here is secret -- it all ships to the browser. Never put a private
# key or an API secret in this file.

# The deployed 18Cosmos contract. Must be the SAME address the session key's
# authz grant is scoped to (config.ts handles that -- it is one constant now).
REACT_APP_CONTRACT_ADDRESS=juno1yourcontractaddresshere000000000000000000

# The developer treasury that pays gas for session-key transactions.
# MUST equal the contract's own `GameConfig::developer_treasury`. If these two
# differ, the treasury accrues fees from lobby deposits while every player's
# session-key transaction fails for want of a fee grant.
REACT_APP_FEE_GRANTER=juno1yourfeegranteraddresshere0000000000000000

# Chain id passed to keplr.enable / getOfflineSigner.
#   mainnet: juno-1     testnet: uni-7
REACT_APP_CHAIN_ID=juno-1

# RPC endpoint for both signing clients.
REACT_APP_RPC_ENDPOINT=https://rpc-juno.itastakers.com
