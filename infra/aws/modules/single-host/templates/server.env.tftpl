# COST-1: the game server's environment -- EXACTLY L5-7 §14's references (no secret, no credential, no data directory),
# plus the single-host metric profile. BUILD_ID is added by gs-run from the deployed release. Docker --env-file format.
GS_MODE=production
GS_STORAGE=aws
GS_AWS_CONFIG_PARAMETER=${runtime_parameter_arn}
PORT=${container_port}
GS_ALLOWED_ORIGINS=${allowed_origins}
GS_TRUSTED_PROXY_HOPS=${trusted_proxy_hops}
GS_METRICS_PROFILE=single-host
%{ if money_tables ~}
ESCROW_MONEY_TABLES=nonmainnet
%{ endif ~}
%{ if edge_diagnostic ~}
GS_EDGE_DIAGNOSTIC=staging
%{ endif ~}
