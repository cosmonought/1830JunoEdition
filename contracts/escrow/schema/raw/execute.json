        "signer_key_id": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "state_schema_version": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "version": {
          "description": "Exactly 1.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "SignedCheckpoint": {
      "description": "A signed Checkpoint payload carried inside `LivenessSettle`.",
