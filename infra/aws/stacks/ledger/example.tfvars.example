# Copy to <env>.tfvars (not committed) and apply with the LEDGER account's credentials:
#   terraform init -backend-config="bucket=<state bucket>" -backend-config="key=gs/<env>/ledger.tfstate" -backend-config="region=<region>"
#   terraform plan -var-file=<env>.tfvars -out=ledger.tfplan
region            = "us-east-1"
ledger_account_id = "222222222222"
environment       = "staging"
app_account_id    = "111111111111" # equal to ledger_account_id for the single-account form

backup = {
  retention_days  = 35
  vault_lock_mode = "governance" # "compliance" (+ changeable_for_days >= 3) is irreversible: an owner decision
}

# LIVE-6 relayer rotation (infra/aws/README.md "Relayer rotation"): 1 = one relayer key. Raise by ONE to prepare a
# rotation (the new key r<N> is created beside the current one); never lower it (prevent_destroy refuses).
# relayer_key_count = 2

# JX-1K financial key sets (infra/aws/README.md "Financial key sets"): each label adds a dedicated settlement-<label> +
# admission-<label> pair. APPEND-ONLY: never remove a label (prevent_destroy refuses). The app stack -- or, on the COST-1
# single host, stacks/single-host -- then names financial_key_arns.<label>.settlement / .admission in signing_keys.
# COST (infra/aws/COST_BUDGET.json max_kms_keys = 6): the LIVE-6 -> JX-1 transition is the three keys + r2 + this pair = 6;
# a further label or rotation key is an owner budget decision (docs/hosting-budget.md), never a tfvars edit alone.
# financial_key_sets = ["jx1"]

# PHASE 3 ESCROW 2.1 (owner decision 2026-10-08): the DEDICATED REMEDY signing key -- escrow 2.1.0's REMEDY attestation
# authority, its own purpose (never the relayer, settlement or admission key). APPEND-ONLY (prevent_destroy). Create it
# BEFORE the 2.1 instantiate: `npm run awsDeploy -- signer-keys ... --remedy <remedy_key_arns.r1>` derives the public key
# the contract's `remedy_keys` registers. Then the app stack (and, on the COST-1 single host, stacks/single-host) names it
# as `remedy_signing_key`. COST: +1 key-month ($1). Live staging (read-only KMS inventory 2026-10-08) holds 3 project keys
# (relayer r1, settlement, admission; no relayer-r2, no jx1 pair), so the remedy key makes 4 of max_kms_keys (6). FUTURE
# scenario only: if the LIVE-6 -> JX-1 transition keys above are ever created beside it, the total (7) exceeds 6 -- an owner
# budget decision (docs/hosting-budget.md), never a tfvars edit alone.
# remedy_key_count = 1
