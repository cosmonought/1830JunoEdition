{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GamesResponse",
  "type": "object",
  "required": [
    "games"
  ],
  "properties": {
    "games": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/GameSummary"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "GameState": {
      "description": "The frozen game lifecycle (ESCROW-1.5 §9). SETTLED, CANCELLED and ANNULLED are terminal and accept no message.",
      "type": "string",
      "enum": [
        "funding",
        "funded",
        "in_progress",
        "settleable",
        "disputed",
        "settled",
        "cancelled",
        "annulled"
      ]
    },
    "GameSummary": {
      "type": "object",
      "required": [
        "ante_gross",
        "chain_game_id",
        "creator",
        "max_players",
        "mode",
        "pool",
        "seats_filled",
        "state"
      ],
      "properties": {
        "ante_gross": {
          "$ref": "#/definitions/Uint128"
        },
        "chain_game_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "creator": {
          "type": "string"
        },
        "max_players": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "mode": {
          "$ref": "#/definitions/Mode"
        },
        "pool": {
          "$ref": "#/definitions/Uint128"
        },
        "seats_filled": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "state": {
          "$ref": "#/definitions/GameState"
        }
      },
      "additionalProperties": false
    },
    "Mode": {
      "description": "Live or async; its byte (0 or 1) is part of the settlement domain.",
      "type": "string",
      "enum": [
        "live",
        "async"
      ]
    },
    "Uint128": {
      "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
      "type": "string"
    }
  }
}
