# COST-1: an EXAMPLE single-host stack configuration (staging). Copy to <env>.tfvars; every value below is a placeholder.
region           = "us-east-1"
app_account_id   = "111111111111"
environment      = "staging"
pool             = "p1"
generation       = 1
game_generations = [1]
ledger_table_arn = "arn:aws:dynamodb:us-east-1:222222222222:table/gs-staging-ledger"

# The keys the Juno document names (null without escrow). Public keys / relayer address: `npm run awsDeploy -- signer-keys`.
signing_keys = {
  relayer    = "arn:aws:kms:us-east-1:222222222222:key/11111111-1111-4111-8111-111111111111"
  settlement = "arn:aws:kms:us-east-1:222222222222:key/22222222-2222-4222-8222-222222222222"
  admission  = "arn:aws:kms:us-east-1:222222222222:key/33333333-3333-4333-8333-333333333333"
}
# PHASE 3 ESCROW 2.1: the DEDICATED REMEDY key -- the SAME ARN as the app stack's remedy_signing_key (null: no remedy key).
# remedy_signing_key = "arn:aws:kms:us-east-1:222222222222:key/77777777-7777-4777-8777-777777777777"
escrow_enabled          = true
money_tables_nonmainnet = true

network = {
  vpc_id    = "vpc-0123456789abcdef0"
  subnet_id = "subnet-0bbbbbbbbbbbbbbb1" # a PUBLIC subnet (route to an internet gateway); no NAT
}

instance = {
  type   = "t4g.small"             # the budget's default (2 GB Graviton). Never t4g.micro before the measurement plan.
  ami_id = "ami-0123456789abcdef0" # AL2023 arm64, pinned: aws ssm get-parameter --name /aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-arm64
}

origin_hostname = "gs-origin.example.org" # its A record -> the `public_ip` output (owner DNS action at migration)
allowed_origins = ["https://play.example.org"]
# acme_email    = null                  # optional; no address is ever invented

alarm_action_arns = [] # SNS topics created elsewhere; empty is valid

# The account budget: REQUIRED at migration (SINGLE_HOST_MIGRATION.md step 9) -- enable it with an owner-named subscriber
# (AWS requires one; none is invented here). A member account's budget sees only that account: see the runbook for the
# ledger account / payer account.
budget = {
  enabled         = false # true, with the owner's address or SNS topic
  email_addresses = []
}
