{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecuteMsg",
  "oneOf": [
    {
      "description": "Opens a game with the creator's deposit (exactly one coin of the configured denom, at least `min_ante`). The creator becomes seat 0.",
      "type": "object",
      "required": [
        "create_game"
      ],
      "properties": {
        "create_game": {
          "type": "object",
          "required": [
            "consent_pubkey",
            "join_ticket",
            "max_players",
            "mode",
            "no_deadline",
            "rules_engine_version",
            "variants_digest"
          ],
          "properties": {
            "consent_pubkey": {
              "description": "33-byte compressed secp256k1 key.",
              "allOf": [
                {
                  "$ref": "#/definitions/HexBinary"
                }
              ]
            },
            "join_ticket": {
              "description": "32 bytes, stored verbatim.",
              "allOf": [
                {
                  "$ref": "#/definitions/HexBinary"
                }
              ]
            },
            "max_players": {
              "type": "integer",
              "format": "uint8",
              "minimum": 0.0
            },
            "mode": {
              "$ref": "#/definitions/Mode"
            },
            "no_deadline": {
              "description": "Escrow 2.1.0, required: `true` for an Async table with no action deadline (`GamePolicy::NoDeadline`), `false` for a table with one (`GamePolicy::TimedNoRemedies` in this build). A Live game is always timed: `true` with `mode: live` is refused. Frozen into the game's terms. (An escrow 2.0.0 CreateGame without the field does not decode: the deadline class is never chosen by default.)",
              "type": "boolean"
            },
            "rules_engine_version": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "variants_digest": {
              "description": "32 bytes.",
              "allOf": [
                {
                  "$ref": "#/definitions/HexBinary"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Takes the next seat with exactly the creator's gross ante. The consent key must not be another seat's current key. The admission must be the admission key's signature for (this chain, this contract, this game, the sender, this ticket, its expiry); it is checked before anything changes.",
      "type": "object",
      "required": [
        "join"
      ],
      "properties": {
        "join": {
          "type": "object",
          "required": [
            "admission",
            "chain_game_id",
            "consent_pubkey",
            "join_ticket"
          ],
          "properties": {
            "admission": {
              "$ref": "#/definitions/JoinAdmission"
            },
            "chain_game_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "consent_pubkey": {
              "$ref": "#/definitions/HexBinary"
            },
            "join_ticket": {
              "description": "32 bytes, stored verbatim.",
              "allOf": [
                {
                  "$ref": "#/definitions/HexBinary"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "A seated wallet leaves before `Start` and gets its net ante back.",
      "type": "object",
      "required": [
        "withdraw"
      ],
      "properties": {
        "withdraw": {
          "type": "object",
          "required": [
            "chain_game_id"
          ],
          "properties": {
            "chain_game_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Before `Start`: the creator at any time, anyone after the funding deadline. Refunds every seat's net ante.",
      "type": "object",
      "required": [
        "cancel"
      ],
      "properties": {
        "cancel": {
          "type": "object",
          "required": [
            "chain_game_id"
          ],
          "properties": {
            "chain_game_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "The seat's own wallet replaces its consent key (never with another seat's current key). A real rotation withdraws the seat's recorded consent to the stored settlement; re-setting the current key is a no-op.",
      "type": "object",
      "required": [
        "set_consent_key"
      ],
      "properties": {
        "set_consent_key": {
          "type": "object",
          "required": [
            "chain_game_id",
            "new_pubkey"
          ],
          "properties": {
            "chain_game_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "new_pubkey": {
              "$ref": "#/definitions/HexBinary"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Operator only: freezes the roster, domain, bond and windows.",
      "type": "object",
      "required": [
        "start"
      ],
      "properties": {
        "start": {
          "type": "object",
          "required": [
            "chain_game_id",
            "roster_hash"
          ],
          "properties": {
            "chain_game_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "roster_hash": {
              "description": "32 bytes; must equal the on-chain roster's hash.",
              "allOf": [
                {
                  "$ref": "#/definitions/HexBinary"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Anyone: posts a signed Checkpoint payload. Works while paused (it moves no funds).",
      "type": "object",
      "required": [
        "checkpoint"
      ],
      "properties": {
        "checkpoint": {
          "type": "object",
          "required": [
            "chain_game_id",
            "payload",
            "signature"
          ],
          "properties": {
            "chain_game_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "payload": {
              "$ref": "#/definitions/SettlementPayloadV1"
            },
            "signature": {
              "$ref": "#/definitions/HexBinary"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Anyone: posts a signed Terminal payload plus any seat consents. Every supplied consent must verify; all seats consenting settles at once.",
      "type": "object",
      "required": [
        "settle"
      ],
      "properties": {
        "settle": {
          "type": "object",
          "required": [
            "chain_game_id",
            "consents",
            "payload",
            "signature"
          ],
          "properties": {
            "chain_game_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "consents": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/SeatSignature"
              }
            },
            "payload": {
              "$ref": "#/definitions/SettlementPayloadV1"
            },
            "signature": {
              "$ref": "#/definitions/HexBinary"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Anyone: adds one seat's consent to the stored settlement.",
      "type": "object",
      "required": [
        "consent"
      ],
      "properties": {
        "consent": {
          "type": "object",
          "required": [
            "chain_game_id",
            "seat_index",
            "signature"
          ],
          "properties": {
            "chain_game_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "seat_index": {
              "type": "integer",
              "format": "uint8",
              "minimum": 0.0
            },
            "signature": {
              "$ref": "#/definitions/HexBinary"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Anyone, once the challenge window has closed.",
      "type": "object",
      "required": [
        "finalize"
      ],
      "properties": {
        "finalize": {
          "type": "object",
          "required": [
            "chain_game_id"
          ],
          "properties": {
            "chain_game_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "A seated wallet, before the window closes, with exactly the game's bond.",
      "type": "object",
      "required": [
        "challenge"
      ],
      "properties": {
        "challenge": {
          "type": "object",
          "required": [
            "chain_game_id",
            "evidence_hash"
          ],
          "properties": {
            "chain_game_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "evidence_hash": {
              "description": "32 bytes, stored for the resolver.",
              "allOf": [
                {
                  "$ref": "#/definitions/HexBinary"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Resolver only, on a disputed game.",
      "type": "object",
      "required": [
        "resolve"
      ],
      "properties": {
        "resolve": {
          "type": "object",
          "required": [
            "chain_game_id",
            "outcome"
          ],
          "properties": {
            "chain_game_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "outcome": {
              "$ref": "#/definitions/ResolveOutcome"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Anyone, with a valid ANNUL signature from every seat over the game's trusted sequence (`GameResponse::trusted_seq`).",
      "type": "object",
      "required": [
        "annul_by_consent"
      ],
      "properties": {
        "annul_by_consent": {
          "type": "object",
          "required": [
            "chain_game_id",
            "consents"
          ],
          "properties": {
            "chain_game_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "consents": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/SeatSignature"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "A seated wallet: the liveness exit. Works while paused. Available for SETTLEABLE from `window_end + liveness_window` and for DISPUTED after the resolver timeout. IN_PROGRESS only for a game created by escrow 2.0.0 code (after its inactivity window); a 2.1.0 game refuses it while IN_PROGRESS (`LivenessExitRemoved`), at any time.",
      "type": "object",
      "required": [
        "liveness_settle"
      ],
      "properties": {
        "liveness_settle": {
          "type": "object",
          "required": [
            "chain_game_id"
          ],
          "properties": {
            "chain_game_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "checkpoint": {
              "description": "IN_PROGRESS (2.0.0 games) only: a newer signed checkpoint, validated exactly like `Checkpoint` and promoted in the same transaction. Eligibility is decided before it is processed, and it does not restart the liveness clock. Omit it (or pass null) for the plain exit.",
              "default": null,
              "anyOf": [
                {
                  "$ref": "#/definitions/SignedCheckpoint"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Escrow 2.1.0, a seated wallet of an IN_PROGRESS No-deadline game: asks the game's resolver for the exceptional review. Records the first request (seat and time); a later request changes nothing; an accepted `Checkpoint` withdraws it. Moves no funds; works while paused.",
      "type": "object",
      "required": [
        "request_review"
      ],
      "properties": {
        "request_review": {
          "type": "object",
          "required": [
            "chain_game_id"
          ],
          "properties": {
            "chain_game_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Escrow 2.1.0, the game's resolver (the address it adopted at `Start`, never one of the game's own seats) only, on an IN_PROGRESS No-deadline game whose review was requested at least `terms.review_delay_secs` ago (`GameDeadlines::review_annul_available_at`): refunds every seat's net deposit (ANNULLED). It carries no payload and no amounts: the only outcome it can produce is the neutral refund. Works while paused.",
      "type": "object",
      "required": [
        "review_annul"
      ],
      "properties": {
        "review_annul": {
          "type": "object",
          "required": [
            "chain_game_id"
          ],
          "properties": {
            "chain_game_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "pause"
      ],
      "properties": {
        "pause": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "unpause"
      ],
      "properties": {
        "unpause": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "add_signer_key"
      ],
      "properties": {
        "add_signer_key": {
          "type": "object",
          "required": [
            "pubkey"
          ],
          "properties": {
            "pubkey": {
              "$ref": "#/definitions/HexBinary"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Retire a key; `compromised: true` also stops `LivenessSettle` from using its checkpoints and settlements and removes their sequence authority. A retired key may be escalated to compromised later; never the reverse.",
      "type": "object",
      "required": [
        "retire_signer_key"
      ],
      "properties": {
        "retire_signer_key": {
          "type": "object",
          "required": [
            "compromised",
            "key_id"
          ],
          "properties": {
            "compromised": {
              "type": "boolean"
            },
            "key_id": {
              "type": "integer",
              "format": "uint16",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "set_operator"
      ],
      "properties": {
        "set_operator": {
          "type": "object",
          "required": [
            "operator"
          ],
          "properties": {
            "operator": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Applies to games started afterwards: a started game keeps the resolver it adopted at `Start`.",
      "type": "object",
      "required": [
        "set_resolver"
      ],
      "properties": {
        "set_resolver": {
          "type": "object",
          "required": [
            "resolver"
          ],
          "properties": {
            "resolver": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Applies to games created afterwards.",
      "type": "object",
      "required": [
        "set_treasury"
      ],
      "properties": {
        "set_treasury": {
          "type": "object",
          "required": [
            "treasury"
          ],
          "properties": {
            "treasury": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Applies to games created afterwards.",
      "type": "object",
      "required": [
        "set_params"
      ],
      "properties": {
        "set_params": {
          "type": "object",
          "required": [
            "params"
          ],
          "properties": {
            "params": {
              "$ref": "#/definitions/GameParams"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Replaces the join-admission key (33-byte compressed, on the curve, never a registered signer key). Takes effect at once: every admission signed under the previous key stops verifying; seats already taken are kept.",
      "type": "object",
      "required": [
        "set_admission_key"
      ],
      "properties": {
        "set_admission_key": {
          "type": "object",
          "required": [
            "pubkey"
          ],
          "properties": {
            "pubkey": {
              "$ref": "#/definitions/HexBinary"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "GameParams": {
      "description": "Economic parameters. A game copies them when it is created, so a later `SetParams` never changes a game that already exists.",
      "type": "object",
      "required": [
        "bond_bps",
        "bond_floor",
        "challenge_window_async_secs",
        "challenge_window_live_secs",
        "funding_period_async_secs",
        "funding_period_live_secs",
        "liveness_window_secs",
        "min_ante",
        "resolver_timeout_secs",
        "subsidy_bps"
      ],
      "properties": {
        "bond_bps": {
          "description": "Bond = max(bond_floor, ante_net · bond_bps / 10_000), fixed at `Start`.",
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "bond_floor": {
          "$ref": "#/definitions/Uint128"
        },
        "challenge_window_async_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "challenge_window_live_secs": {
          "description": "Challenge window after a settlement is stored, per mode.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "funding_period_async_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "funding_period_live_secs": {
          "description": "Time from `CreateGame` to the funding deadline, per mode.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "liveness_window_secs": {
          "description": "After a SETTLEABLE game's `window_end`, the wait before a seated wallet may `LivenessSettle` it. (Escrow 2.0.0 games also used it as the IN_PROGRESS inactivity window; 2.1.0 games have no IN_PROGRESS exit.)",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "min_ante": {
          "description": "Smallest gross ante `CreateGame` accepts.",
          "allOf": [
            {
              "$ref": "#/definitions/Uint128"
            }
          ]
        },
        "resolver_timeout_secs": {
          "description": "DISPUTED time after which a seated wallet may `LivenessSettle`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "review_delay_secs": {
          "description": "Escrow 2.1.0: the wait from a No-deadline game's first review request to the earliest `ReviewAnnul`, so the table can notice (and finish and `Settle`, or post a checkpoint, which withdraws the request) before a resolver acts. Snapshotted into each game at CreateGame. Validated like the other durations (1 s … 10 y); the value is a deployment choice. A configuration carried over from 2.0.0 reads 0 here, and a No-deadline game cannot be created until the admin sets it (`SetParams`).",
          "default": 0,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "subsidy_bps": {
          "description": "Basis points of EVERY deposit (creator and joiners) sent to the treasury.",
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "HexBinary": {
      "description": "This is a wrapper around Vec<u8> to add hex de/serialization with serde. It also adds some helper methods to help encode inline.\n\nThis is similar to `cosmwasm_std::Binary` but uses hex. See also <https://github.com/CosmWasm/cosmwasm/blob/main/docs/MESSAGE_TYPES.md>.",
      "type": "string"
    },
    "JoinAdmission": {
      "description": "The hosted server's authorization for the `Join` transaction's SENDER to take a seat in this game with this join ticket (`crypto::join_admission_digest`). It names no wallet: the digest is rebuilt from `info.sender`, so an admission copied into another wallet's `Join` never verifies.",
      "type": "object",
      "required": [
        "expires_at",
        "signature"
      ],
      "properties": {
        "expires_at": {
          "description": "Unix seconds; `Join` needs block time (whole seconds) strictly before it.",
          "allOf": [
            {
              "$ref": "#/definitions/Uint64"
            }
          ]
        },
        "signature": {
          "description": "64-byte low-s `r ‖ s` by `Config::admission_pubkey` over the JOIN digest.",
          "allOf": [
            {
              "$ref": "#/definitions/HexBinary"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Mode": {
      "description": "Live or async; its byte (0 or 1) is part of the settlement domain.",
      "type": "string",
      "enum": [
        "live",
        "async"
      ]
    },
    "ResolveOutcome": {
      "oneOf": [
        {
          "description": "The stored settlement stands; the challenger's bond joins the pool.",
          "type": "object",
          "required": [
            "uphold"
          ],
          "properties": {
            "uphold": {
              "type": "object",
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "description": "A corrected payload (reason ResolverCorrection) authorised by the resolver's transaction; the bond goes back to the challenger. Its seq must exceed the game's trusted checkpoint floor only: the disputed settlement never constrains it, so the same log position is legal.",
          "type": "object",
          "required": [
            "replace"
          ],
          "properties": {
            "replace": {
              "type": "object",
              "required": [
                "payload"
              ],
              "properties": {
                "payload": {
                  "$ref": "#/definitions/SettlementPayloadV1"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Refund every seat's net ante; the bond goes back to the challenger.",
          "type": "object",
          "required": [
            "annul"
          ],
          "properties": {
            "annul": {
              "type": "object",
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "SeatSignature": {
      "description": "A seat's consent (or annul) signature: 64-byte low-s `r ‖ s`.",
      "type": "object",
      "required": [
        "seat_index",
        "signature"
      ],
      "properties": {
        "seat_index": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "signature": {
          "$ref": "#/definitions/HexBinary"
        }
      },
      "additionalProperties": false
    },
    "SettlementPayloadV1": {
      "description": "SettlementPayloadV1, amended layout (SET-0A rev 2 §21), in field order. The contract re-encodes it to the canonical `136 + 16·n` bytes before hashing; nothing here is hashed as JSON.",
      "type": "object",
      "required": [
        "appraisal_log_len",
        "appraisal_state_hash",
        "domain",
